# Copy to .env (never committed). Read by `make` targets (docker --env-file) and the scripts.
# MLflow: https://ml.pettrace.app (basic auth). Reviewers get a read-only user.
MLFLOW_TRACKING_URI=https://ml.pettrace.app
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
# Hugging Face: read token for experiments; dataset publication needs write access to pettrace-training.
HF_TOKEN=

# Optional shared training dataset on HF. Leave repo blank to use a local prepared version.
HF_TRAINING_DATASET_REPO=
HF_TRAINING_DATASET_VERSION=v1
HF_TRAINING_DATASET_REVISION=v1
HF_TRAINING_DATASET_FINGERPRINT=
